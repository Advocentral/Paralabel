# --- Core ---
# Postgres in prod; SQLite is fine for local dev / tests.
DATABASE_URL=sqlite:///./dev.db
# DATABASE_URL=postgresql+psycopg://jev:jev@localhost:5432/jev

# Fernet key for encrypting Google refresh tokens at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Secret for signing dashboard magic-link tokens.
APP_SECRET=change-me

# --- Classifier selection ---
# demo = deterministic keyword scoring, no key needed (default).
# jev  = TypeSafe Jev adapter (fill in credentials once docs are supplied).
# llm  = generic LLM behind a strict JSON schema.
CLASSIFIER=demo

# Cost model: price charged per 1e9 input tokens (USD). Used for usage/cost reporting.
PRICE_PER_BILLION_TOKENS=0.0

# --- Jev (M7) ---
JEV_API_KEY=
JEV_BASE_URL=

# --- LLM fallback (M7) --- no default provider; both required when CLASSIFIER=llm.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Gmail (M2/M3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
# poll (local dev, no Pub/Sub) | push (production)
GMAIL_MODE=poll
GMAIL_POLL_SECONDS=60
# Pub/Sub topic for users.watch, e.g. projects/PROJECT/topics/gmail-push
PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT=

# --- SMTP (digest + reconnect emails + magic-link auth) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=triage@example.com

# --- Retention ---
RETENTION_DAYS=30

# --- Per-tenant limits ---
MAX_ENABLED_QUESTIONS=12

# --- Dashboard ---
DASHBOARD_ORIGIN=http://localhost:3000

# --- Public "try the triage" demo endpoint (for the marketing site) ---
DEMO_TEMPLATE=general
DEMO_RATE_PER_HOUR=20
# Max real-Jev classifications/day before falling back to the free demo backend.
DEMO_DAILY_JEV_BUDGET=1000
# If set, callers must send header X-Demo-Token with this value (the site proxy does).
DEMO_SHARED_SECRET=
# Cloudflare Turnstile secret (optional bot check on the public form).
TURNSTILE_SECRET=
